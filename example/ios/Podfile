# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'

# IMPORTANT: order matters — Rolla source must come BEFORE the CocoaPods CDN
# so CocoaPods resolves RollaSDK from the Rolla specs repo first.
source 'https://github.com/Rolla-Health-Fitness/rolla-sdk-release-ios.git'
source 'https://cdn.cocoapods.org/'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# RollaSDK vendors pre-built xcframeworks (Flutter engine, Mapbox, etc.) and
# requires framework linkage. `:linkage => :static` keeps the rest of the RN
# pod graph static-linked.
use_frameworks! :linkage => :static
ENV['NO_FLIPPER'] = '1'

target 'RollaWrapperScaffoldExample' do
  config = use_native_modules!

  # ZIPFoundation must be dynamic — NordicDFU expects it that way.
  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if pod.name == 'ZIPFoundation'
        def pod.build_type
          Pod::BuildType.dynamic_framework
        end
      end
    end
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        if target.name == 'ZIPFoundation'
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
        end
      end
    end
  end
end
